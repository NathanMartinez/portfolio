{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run cf-typegen && vite dev",
		"build": "bun run cf-typegen && vite build",
		"preview": "bun run build && wrangler dev --ip 127.0.0.1 --port 8787",
		"prepare": "bun run cf-typegen && svelte-kit sync",
		"check": "bun run cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun run test:e2e",
		"test:e2e": "playwright test",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "mkdir -p .wrangler/types && wrangler types .wrangler/types/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24.12.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.3",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.8",
		"wrangler": "^4.81.0"
	}
}
