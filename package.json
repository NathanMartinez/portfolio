{
	"name": "portfolio",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "npm run cf-typegen && vite dev",
		"dev:host": "npm run cf-typegen && vite dev --host",
		"build": "npm run cf-typegen && vite build",
		"preview": "wrangler dev --ip 127.0.0.1 --port 8787",
		"prepare": "npm run cf-typegen && svelte-kit sync",
		"check": "npm run cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run format:check && eslint .",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"test": "npm run build && playwright test",
		"deploy": "npm run validate && wrangler deploy",
		"cf-typegen": "node scripts/cf-typegen.mjs",
		"validate": "npm run lint && npm run check && npm run test && npm run check"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260917.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"wrangler": "^4.149.0"
	},
	"engines": {
		"node": "24.x"
	}
}
